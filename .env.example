# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://dhanwantari:change_me_db_password@localhost:5432/dhanwantari?schema=public"

# NextAuth: URL of the site and a long random secret
# Generate a secret in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_a_long_random_string"

# Password given to the demo accounts created by the seed script
SEED_DEMO_PASSWORD="ChangeMe@12345"

# Hospital details shown on the site (replace with VERIFIED information)
NEXT_PUBLIC_HOSPITAL_NAME="Dhanwantari Hospital"
NEXT_PUBLIC_HOSPITAL_PHONE="+91-00000-00000"
NEXT_PUBLIC_HOSPITAL_EMAIL="info@example.com"
NEXT_PUBLIC_HOSPITAL_ADDRESS="Address to be verified"

# Optional notification integrations. Leave empty to log messages to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
